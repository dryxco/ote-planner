# Copy to .env.local and fill in.

# ---- sign-in (at least one; with neither, nobody can sign in) ----
# Password for the sign-in page (single user). Use a long one if the server is reachable by others.
SYNC_PASSWORD=
# Optional: a device-code sign-in with a server of your own implementing the REST connector's
# /auth/device endpoints (src/lib/server/connectors/README.md), and who may sign in that way
# (user ids or emails, comma-separated; empty = nobody).
# SYNC_LOGIN_URL=https://example.com/sync-api
# SYNC_LOGIN_LABEL=Example
# SYNC_ALLOWED_USERS=
# Optional: behind `tailscale serve`, also require one of these Tailscale logins.
# SYNC_ALLOWED_TAILSCALE_USERS=
# Only for a server nobody else can reach: turn the sign-in off altogether.
# SYNC_AUTH=off

# Public base URL of this app (used for the Google OAuth redirect URI).
APP_URL=http://localhost:3000

# Encrypts .data/integrations.json (AES-256-GCM). Generate with: openssl rand -base64 32
# If unset, a dev key is generated into .data/dev-secret (with a console warning).
# Changing it later makes existing connections unreadable.
SYNC_SECRET=

# Google Calendar (OAuth client of type "Web application").
# Authorized redirect URI: ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- connector (Settings → Connector) ----
# Pre-fills the REST connector's server URL in Settings.
# SYNC_CONNECTOR_URL=
# Time zone of the connector's task dates/times when its /me doesn't say (default: the server's).
# SYNC_CONNECTOR_TZ=Europe/Berlin

# ---- agent chat (optional): uses this machine's Claude Code login (`claude -p`) ----
# SYNC_CLAUDE_BIN=/path/to/claude
# SYNC_AGENT_MODEL=sonnet
